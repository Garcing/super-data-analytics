# 公司 OpenVPN 客户端配置（容器版）
# 由 2020 年 Windows 版 client.ovpn 改造：
#   - 密钥路径改为运行时挂载目录 /etc/openvpn/runtime/（gitignored，不进镜像）
#   - 删除 Windows 专用指令 route-method exe / route-delay 2
#   - auth-user-pass 指向账密文件（容器无法交互输入）
#   - data-ciphers-fallback / auth SHA1：兼容 2.4 时代服务端
client
dev tun
proto udp
remote 47.99.47.121 2294
resolv-retry infinite
nobind
persist-key
persist-tun
keepalive 10 120
cipher AES-256-CBC
data-ciphers-fallback AES-256-CBC
auth SHA1
comp-lzo
verb 3
ca /etc/openvpn/runtime/ca.crt
tls-auth /etc/openvpn/runtime/ta.key 1
auth-user-pass /etc/openvpn/runtime/pass.txt
